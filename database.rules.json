{
  /* Visit https://firebase.google.com/docs/database/security to learn more about security rules. */
  "rules": {
    "projects": {
      "$projectId": {
        ".read": true,
        ".write": true
      }
    },
    "pushSubscriptions": {
      "$projectId": {
        ".read": "auth != null",
        "$subscriptionId": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    },
    "pushDeliveries": {
      "$projectId": {
        ".read": "auth != null",
        "$deliveryId": {
          ".write": "auth != null"
        }
      }
    },
    "reminderProjects": {
      "$projectId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}